<?php

namespace App\Http\Controllers\Bitrix24;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Illuminate\View\View;

class InstallController extends Controller
{
    public function install(Request $request): View
    {
        try {
            app(\X3Group\Bitrix24\Application\Install\InstallService::class)->handleInstallPage($request);

            return view('b24api.install');
        } catch (\Throwable $e) {
            logger()->error('install failed', ['error' => $e->getMessage(), 'trace' => $e->getTraceAsString()]);

            return view('b24api.install-fail');
        }
    }
}
